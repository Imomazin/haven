# Haven — environment variables
# Copy to .env.local for local development. NEVER commit real credentials.
# This is a PUBLIC repository: every committed file is externally visible.

# Neon PostgreSQL pooled connection string (used by the running app).
# Format: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL="postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct (unpooled) connection — used for migrations only.
# Same as DATABASE_URL but WITHOUT the "-pooler" segment in the host.
DIRECT_URL="postgresql://user:password@your-endpoint.region.aws.neon.tech/neondb?sslmode=require"

# Optional: label shown in the app header to identify the environment (e.g. "preview", "local").
NEXT_PUBLIC_ENV_LABEL="local"
